{
  "name": "engineering-checklist-backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --exec \"node --env-file=.env.dev\" src/server.js",

    "db:generate": "prisma generate",
    "db:generate:dev": "node --env-file=.env.dev ./node_modules/prisma/build/index.js generate",

    "db:migrate": "node --env-file=.env.dev ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",

    "db:studio": "node --env-file=.env.dev ./node_modules/prisma/build/index.js studio",
    "db:studio:prod": "node --env-file=.env ./node_modules/prisma/build/index.js studio"
    },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.1": true,
    "bcrypt@6.0.0": true,
    "prisma@7.10.1": true
  }
}
