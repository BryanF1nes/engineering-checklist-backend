generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id          Int      @id @default(autoincrement())
    firstName   String
    lastName    String?
    email       String   @unique
    password    String
    avatarColor String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Project relationships
    ownedProjects  Project[]       @relation("ProjectOwner")
    ledProjects    Project[]       @relation("ProjectLead")
    memberships    ProjectMember[]
    assignedTasks  ChecklistItem[] @relation("TaskAssignee")
    completedTasks ChecklistItem[] @relation("TaskCompletedBy")
    checklistItems ChecklistItem[]

    // Invitation relationships
    createdInvites     ProjectInvite[]
    createdTeamInvites TeamInvite[]    @relation("TeamInviteCreator")

    // Team relationships
    teamMembers TeamMember[]

    // Authentication
    refreshTokens RefreshToken[]
}

model Project {
    id            Int     @id @default(autoincrement())
    name          String
    description   String?
    projectCode   String?
    ownerId       Int?
    projectLeadId Int?

    status     ProjectStatus @default(ONGOING)
    stage      ProjectStage  @default(TEN)
    createdAt  DateTime      @default(now())
    updatedAt  DateTime      @updatedAt
    finishedAt DateTime?

    // Creator/reference, not organizational ownership
    owner User? @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

    // Project-specific lead
    projectLead User? @relation("ProjectLead", fields: [projectLeadId], references: [id], onDelete: SetNull)

    // Legacy relationships (remove after migration)
    members     ProjectMember[]
    invitations ProjectInvite[]

    // Team workspace
    teamId String?
    team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

    // Folder organization
    projectFolderId String?
    projectFolder   ProjectFolder? @relation(fields: [projectFolderId], references: [id], onDelete: SetNull)

    // Checklist
    items ChecklistItem[]

    @@index([ownerId])
    @@index([projectLeadId])
    @@index([teamId, status])
    @@index([projectFolderId])
}

model ChecklistItem {
    id                Int          @id @default(autoincrement())
    title             String
    status            ItemStatus   @default(ONGOING)
    priority          TaskPriority @default(MEDIUM)
    dueDate           DateTime?
    estimatedDuration Int?

    projectId     Int
    assignedTo    Int?
    completedById Int?

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    completedAt DateTime?

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    assignee User? @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

    completedBy User? @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

    // Legacy relationship; remove if no longer used
    userId Int?
    user   User? @relation(fields: [userId], references: [id])

    @@index([projectId])
    @@index([projectId, priority])
    @@index([assignedTo])
    @@index([assignedTo, status])
    @@index([completedById])
}

model Team {
    id   String @id @default(cuid())
    name String
    slug String @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    members  TeamMember[]
    projects Project[]
    folders  ProjectFolder[]
    invites  TeamInvite[]
}

model TeamMember {
    id       String   @id @default(cuid())
    teamId   String
    userId   Int
    role     TeamRole @default(CONTRIBUTOR)
    joinedAt DateTime @default(now())

    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([teamId, userId])
    @@index([userId])
    @@index([teamId, role])
}

model TeamInvite {
    id          String    @id @default(cuid())
    teamId      String
    tokenHash   String    @unique
    email       String?
    role        TeamRole  @default(CONTRIBUTOR)
    createdById Int
    expiresAt   DateTime
    revokedAt   DateTime?
    acceptedAt  DateTime?
    createdAt   DateTime  @default(now())

    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

    createdBy User @relation("TeamInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)

    @@index([teamId])
    @@index([teamId, expiresAt])
    @@index([createdById])
}

model ProjectFolder {
    id   String @id @default(cuid())
    name String

    teamId         String
    parentFolderId String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

    parentFolder ProjectFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: SetNull)
    subfolders   ProjectFolder[] @relation("FolderHierarchy")

    projects Project[]

    @@index([teamId])
    @@index([parentFolderId])
    @@index([teamId, parentFolderId])
}

// Legacy project-level membership.
// Keep until existing project access is migrated to TeamMember.
model ProjectMember {
    id        Int         @id @default(autoincrement())
    projectId Int
    userId    Int
    role      ProjectRole @default(VIEWER)
    joinedAt  DateTime    @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([projectId, userId])
    @@index([userId])
}

// Legacy project-level invitations.
// Keep until existing invitations are migrated or expired.
model ProjectInvite {
    id          Int         @id @default(autoincrement())
    projectId   Int
    role        ProjectRole @default(VIEWER)
    createdById Int
    tokenHash   String      @unique
    expiresAt   DateTime
    revokedAt   DateTime?
    createdAt   DateTime    @default(now())

    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

    @@index([projectId])
}

model RefreshToken {
    id        String    @id @default(cuid())
    tokenHash String    @unique
    familyId  String
    userId    Int
    expiresAt DateTime
    revokedAt DateTime?
    createdAt DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([familyId])
    @@index([expiresAt])
}

enum TeamRole {
    ADMIN
    PROJECT_MANAGER
    PROJECT_LEAD
    CONTRIBUTOR
    VIEWER
}

enum ProjectRole {
    CONTRIBUTOR
    VIEWER
}

enum ItemStatus {
    ONGOING
    COMPLETED
}

enum ProjectStage {
    TEN
    THIRTY
    SIXTY
    NINETY
    BID
    CONSTRUCTION
}

enum ProjectStatus {
    ONGOING
    UNDER_REVIEW
    COMPLETED
}

enum TaskPriority {
    LOW
    MEDIUM
    HIGH
}
