generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id          Int      @id @default(autoincrement())
    name        String
    email       String   @unique
    password    String
    avatarColor String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    ownedProjects  Project[]       @relation("ProjectOwner")
    memberships    ProjectMember[]
    assignedTasks  ChecklistItem[] @relation("TaskAssignee")
    completedTasks ChecklistItem[] @relation("TaskCompletedBy")
    createdInvites ProjectInvite[]
    checklistItems ChecklistItem[]

    refreshTokens RefreshToken[]
}

model Project {
    id          Int           @id @default(autoincrement())
    name        String
    description String?
    projectCode String?
    ownerId     Int
    status      ProjectStatus @default(ONGOING)
    stage       ProjectStage  @default(TEN)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    finishedAt  DateTime?

    owner User @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

    members     ProjectMember[]
    items       ChecklistItem[]
    invitations ProjectInvite[]

    @@index([ownerId])
}

model ChecklistItem {
    id                Int        @id @default(autoincrement())
    title             String
    status            ItemStatus @default(ONGOING)
    dueDate           DateTime?
    projectId         Int
    assignedTo        Int?
    completedById     Int?
    estimatedDuration Int?
    createdAt         DateTime   @default(now())
    updatedAt         DateTime   @updatedAt
    completedAt       DateTime?

    project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    assignee    User?   @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
    completedBy User?   @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
    user        User?   @relation(fields: [userId], references: [id])
    userId      Int?

    @@index([projectId])
    @@index([assignedTo])
    @@index([completedById])
}

model ProjectMember {
    id        Int         @id @default(autoincrement())
    projectId Int
    userId    Int
    role      ProjectRole @default(VIEWER)
    joinedAt  DateTime    @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([projectId, userId])
    @@index([userId])
}

model ProjectInvite {
    id          Int         @id @default(autoincrement())
    projectId   Int
    role        ProjectRole @default(VIEWER)
    createdById Int
    tokenHash   String      @unique
    expiresAt   DateTime
    revokedAt   DateTime?
    createdAt   DateTime    @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

    @@index([projectId])
}

model RefreshToken {
    id        String    @id @default(cuid())
    tokenHash String    @unique
    familyId  String
    userId    Int
    expiresAt DateTime
    revokedAt DateTime?
    createdAt DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([familyId])
    @@index([expiresAt])
}

enum ProjectRole {
    CONTRIBUTOR
    VIEWER
}

enum ItemStatus {
    ONGOING
    COMPLETED
}

enum ProjectStage {
    TEN
    THIRTY
    SIXTY
    NINETY
    BID
    CONSTRUCTION
}

enum ProjectStatus {
    ONGOING
    UNDER_REVIEW
    COMPLETED
}
